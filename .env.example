# ========================================================
# Retail POS & Billing System — Environment Configuration
# Copy this file to '.env' and populate with your settings
# ========================================================

# Application Mode: Set DEBUG=False in production
DEBUG=True

# Django Secret Key: Provide a strong, random 50+ character key in production
SECRET_KEY=django-insecure-retail-pos-demo-key-change-in-production

# Allowed Hosts: Comma-separated list of hostnames/IPs
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ========================================================
# Database Configuration
# ========================================================
# Hosted PostgreSQL Deployment (Render, Neon, Supabase, Railway, AWS):
# Set DATABASE_URL to connect to your PostgreSQL instance.
# Example: DATABASE_URL=postgresql://username:password@localhost:5432/pos_billing_db
#
# If DATABASE_URL is left blank, the application uses an isolated local SQLite file for development.
DATABASE_URL=

# ========================================================
# Telegram Real-Time Notification Service (Optional)
# ========================================================
# Bot credentials for sales receipts, low-stock warnings, and closing digests
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ========================================================
# POS Phone Camera Scanner Configuration (Optional)
# ========================================================
# Explicit LAN base URL for mobile camera scanner pairing (e.g. http://192.168.1.50:8000)
# If left blank, server auto-discovers the PC's primary LAN IPv4 address.
POS_SCANNER_BASE_URL=
